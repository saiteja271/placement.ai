# PlaceMate AI Environment Variables
# If no API key is provided, the application runs seamlessly in
# Fallback Deterministic Demo Mode (Local Python Tools & Heuristics)

DATABASE_URL=sqlite:///./placemate.db
APP_ENV=development

# Optional LLM API Keys for Live Tool-Calling Mode:
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
